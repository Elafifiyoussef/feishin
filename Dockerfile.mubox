# Feishin + mubox pages. Same as the upstream Dockerfile, but uses docker/mubox/ng.conf.template
# (adds the /mubox/ proxy). Build: docker build -f Dockerfile.mubox -t feishin-mubox .
# Run with MUBOX_URL=http://mubox:8000 on the same compose network as mubox (the backend).

# --- Builder stage
FROM node:23-alpine AS builder
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .

RUN corepack enable && corepack prepare pnpm@11.5.2 --activate

RUN pnpm install

COPY . .
RUN pnpm run build:web

# --- Production stage
FROM nginxinc/nginx-unprivileged:alpine-slim

COPY --chown=nginx:nginx --from=builder /app/out/web /usr/share/nginx/html
COPY --chown=nginx:nginx ./settings.js.template /etc/nginx/templates/settings.js.template
COPY --chown=nginx:nginx docker/mubox/ng.conf.template /etc/nginx/templates/default.conf.template

ENV SERVER_LOCK=false SERVER_NAME="" SERVER_TYPE="" SERVER_URL="" REMOTE_URL=""
ENV LEGACY_AUTHENTICATION="" ANALYTICS_DISABLED="" PUBLIC_PATH="/"
ENV MUBOX_URL="http://mubox:8000"

EXPOSE 9180
CMD ["nginx", "-g", "daemon off;"]
